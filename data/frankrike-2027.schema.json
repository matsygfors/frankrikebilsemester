{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Béziers 2027 travel planning dataset v1",
  "description": "Structure for the supplied scenario dataset. Referential and temporal checks also required.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "const": "sv-SE"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "planning_year": {
      "const": 2027
    },
    "planning_status": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "minItems": 2
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "wine_logistics": {
      "$ref": "#/$defs/wine_logistics"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "web_app_contract": {
      "$ref": "#/$defs/web_contract"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "title",
    "language",
    "created_date",
    "planning_year",
    "planning_status",
    "timezone",
    "parties",
    "assumptions",
    "locations",
    "scenarios",
    "wine_logistics",
    "open_questions",
    "web_app_contract",
    "sources"
