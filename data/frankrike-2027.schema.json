        "end_hour": {
          "type": "number",
          "minimum": 0
        },
        "departure_day": {
          "type": "integer",
          "minimum": 1
        },
        "departure_clock_hour": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "planned_elapsed_hours": {
          "type": "number",
          "minimum": 0
